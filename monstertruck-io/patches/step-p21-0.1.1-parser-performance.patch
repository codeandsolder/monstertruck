From e173cfc1d473c6c4eec7b195149c0d8f6387b128 Mon Sep 17 00:00:00 2001
From: codeandsolder <codeandsolder@gmail.com>
Date: Tue, 17 Nov 2026 08:52:39 +0100
Subject: [PATCH] perf(p21): avoid speculative separator and token allocations


diff --git a/crates/step-p21/src/parser/combinator.rs b/crates/step-p21/src/parser/combinator.rs
index b634809..5967cbb 100644
--- a/crates/step-p21/src/parser/combinator.rs
+++ b/crates/step-p21/src/parser/combinator.rs
@@ -122,3 +122,20 @@ pub fn many1_<'a, O>(
-pub fn ignorable(input: &str) -> ParseResult<'_, ()> {
-    let comment = many1(tuple((multispace0, comment, multispace0))).map(|_| ());
-    alt((comment, value((), multispace0))).parse(input)
+pub fn ignorable(mut input: &str) -> ParseResult<'_, ()> {
+    // Speculatively parsing a comment at every token boundary allocates a
+    // VerboseError even when the input contains only ordinary whitespace.
+    // Comments are unambiguous at the byte level, so only invoke their parser
+    // after the slash-star opener is present.
+    loop {
+        let (after_spaces, _) = multispace0(input)?;
+        input = after_spaces;
+        if !input.starts_with("/*") {
+            return Ok((input, ()));
+        }
+        match comment(input) {
+            Ok((after_comment, _)) => input = after_comment,
+            // Preserve the old backtracking behavior for an incomplete
+            // comment opener: ignore the preceding whitespace but let the
+            // following token parser decide how to report the invalid input.
+            Err(nom::Err::Error(_)) => return Ok((input, ())),
+            Err(error) => return Err(error),
+        }
+    }
@@ -399,0 +417,17 @@ mod tests {
+    #[test]
+    fn ignorable_comments_are_skipped_only_with_an_actual_opener() {
+        for (input, rest) in [
+            (" /*first*/  /*second*/\n  VALUE", "VALUE"),
+            ("/*🦀🌳*/TOKEN", "TOKEN"),
+            ("\t\n/* outer /* inner */END", "END"),
+            ("\n //not-a-comment", "//not-a-comment"),
+            ("\t/foo", "/foo"),
+            ("/*unterminated", "/*unterminated"),
+            ("  /*unterminated", "/*unterminated"),
+            ("/*valid*/  /*unterminated", "/*unterminated"),
+        ] {
+            let (remaining, ()) = super::ignorable(input).unwrap();
+            assert_eq!(remaining, rest, "input: {input:?}");
+        }
+    }
+
diff --git a/crates/step-p21/src/parser/token.rs b/crates/step-p21/src/parser/token.rs
index 643069b..98523ca 100644
--- a/crates/step-p21/src/parser/token.rs
+++ b/crates/step-p21/src/parser/token.rs
@@ -54 +54 @@ pub fn real(input: &str) -> ParseResult<'_, f64> {
-    tuple((
+    let (rest, (sign, _space, integral, _point, fractional, exp)) = tuple((
@@ -62,11 +62,14 @@ pub fn real(input: &str) -> ParseResult<'_, f64> {
-    .map(|(sign, _space, integral, _point, fractional, exp)| {
-        let num: f64 =
-            format!("{}.{}e{}", integral, fractional, exp.unwrap_or(0))
-                .parse()
-                .expect("Failed to parse Float");
-        match sign {
-            Some('-') => -num,
-            _ => num,
-        }
-    })
-    .parse(input)
+    .parse(input)?;
+    // Part 21's ordinary real-number spelling is already accepted directly
+    // by f64::from_str. Borrow it from the input instead of allocating and
+    // reparsing a formatted decimal string for every coordinate and vector.
+    // Whitespace between sign/exponent components is also legal per this
+    // parser's grammar; preserve the original normalization for those cases.
+    let token = &input[..input.len() - rest.len()];
+    if let Ok(number) = token.parse::<f64>() {
+        return Ok((rest, number));
+    }
+    let number = format!("{}.{}e{}", integral, fractional, exp.unwrap_or(0))
+        .parse::<f64>()
+        .expect("Failed to parse Float");
+    Ok((rest, if sign == Some('-') { -number } else { number }))
@@ -209 +212,7 @@ pub fn keyword(input: &str) -> ParseResult<'_, String> {
-    alt((user_defined_keyword, standard_keyword)).parse(input)
+    // An extension keyword is syntactically unambiguous at the first byte.
+    // Avoid constructing a recoverable error for every ordinary keyword.
+    if input.starts_with('!') {
+        user_defined_keyword(input)
+    } else {
+        standard_keyword(input)
+    }
@@ -214,6 +223,8 @@ pub fn standard_keyword(input: &str) -> ParseResult<'_, String> {
-    tuple((upper, many0(alt((upper, digit)))))
-        .map(|(first, tail)| {
-            let head = &[first];
-            head.iter().chain(tail.iter()).collect()
-        })
-        .parse(input)
+    let (rest, _) = upper(input)?;
+    let (rest, _) = nom::bytes::complete::take_while(
+        |c: char| matches!(c, 'A'..='Z' | '_' | '0'..='9'),
+    )
+    .parse(rest)?;
+    // Preserve the exact identifier (including underscores) with one string
+    // allocation, instead of allocating Vec<char> and then another String.
+    Ok((rest, input[..input.len() - rest.len()].to_owned()))
@@ -277,0 +289,39 @@ mod tests {
+    #[test]
+    fn keyword_tokenization_preserves_extension_and_boundary_behavior() {
+        for (input, rest, expected) in [
+            (
+                "B_SPLINE_SURFACE_WITH_KNOTS012(foo)",
+                "(foo)",
+                "B_SPLINE_SURFACE_WITH_KNOTS012",
+            ),
+            ("A0_", "", "A0_"),
+            ("!CUSTOM_1(", "(", "CUSTOM_1"),
+            ("_1_2.", ".", "_1_2"),
+        ] {
+            let (remainder, parsed) = super::keyword(input).unwrap();
+            assert_eq!(remainder, rest, "input: {input}");
+            assert_eq!(parsed, expected, "input: {input}");
+        }
+        assert!(super::standard_keyword("0KEY").is_err());
+        assert!(super::standard_keyword("lower").is_err());
+        assert!(super::keyword("!0NAME").is_err());
+    }
+
+    #[test]
+    fn real_fast_path_preserves_bits_and_whitespace_fallback() {
+        for (token, expected) in [
+            ("1.23", 1.23_f64),
+            ("1.23E4", 1.23e4),
+            ("-1.23E-4", -1.23e-4),
+            ("+12.", 12.0),
+            ("-0.0", -0.0),
+            ("0.000000000000000000000000000005", 5e-30),
+            ("1.25E  -  03", 1.25e-3),
+            ("-  2.5", -2.5),
+        ] {
+            let (remainder, parsed) = super::real(token).unwrap();
+            assert_eq!(remainder, "", "token: {token}");
+            assert_eq!(parsed.to_bits(), expected.to_bits(), "token: {token}");
+        }
+    }
+
